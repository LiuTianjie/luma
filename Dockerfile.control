ARG PYTHON_IMAGE=python:3.11-slim

# Pure Python control plane image: Luma Dashboard ships independently as a
# hot-swappable static asset bundle under /opt/luma/dashboard so UI updates
# never require rebuilding or restarting luma-control.
FROM ${PYTHON_IMAGE}

WORKDIR /app

COPY pyproject.toml setup.py MANIFEST.in README.md LICENSE ./
COPY skills ./skills
COPY luma ./luma

RUN pip install --no-cache-dir '.[control]'

EXPOSE 8080

CMD ["python", "-m", "luma.control.server", "serve", "--host", "127.0.0.1", "--port", "8080"]
