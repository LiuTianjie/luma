# Private service endpoints; use TLS when crossing an untrusted network.
LUMA_BUILD_DATABASE_URL=postgresql://luma_build:REPLACE@postgresql:5432/luma_build
LUMA_BUILD_API_TOKEN=REPLACE
LUMA_BUILD_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
LUMA_BUILD_PUBLIC_URL=https://build.internal.example
LUMA_CONTROL_URL=https://control.internal.example
LUMA_DEPLOY_TOKEN=REPLACE
LUMA_TEMPORAL_ADDRESS=temporal.internal.example:7233
LUMA_TEMPORAL_NAMESPACE=luma
LUMA_BUILD_TASK_QUEUE=luma-builds
LUMA_NOMAD_URL=http://nomad.internal.example:4646
LUMA_NOMAD_TOKEN=REPLACE
LUMA_NOMAD_NAMESPACE=builds
LUMA_BUILD_EXECUTOR_IMAGE=registry.internal.example/luma-system/build-executor@sha256:REPLACE
LUMA_BUILD_REGISTRY_URL=https://registry.internal.example
LUMA_BUILD_REGISTRY_PROJECT=luma
# Build worker: project robot with push/pull and tag permission.
LUMA_BUILD_REGISTRY_USERNAME=REPLACE
LUMA_BUILD_REGISTRY_PASSWORD=REPLACE
# Runtime jobs: separate pull-only project robot.
LUMA_BUILD_REGISTRY_PULL_USERNAME=REPLACE
LUMA_BUILD_REGISTRY_PULL_PASSWORD=REPLACE
LUMA_BUILD_S3_ENDPOINT=https://objects.internal.example
LUMA_BUILD_S3_BUCKET=luma-builds
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
LUMA_BUILD_MAX_ACTIVE=10
LUMA_BUILD_MAX_PENDING=100
LUMA_BUILD_MAX_PER_PROJECT=10
LUMA_BUILD_CPU_MHZ=2000
LUMA_BUILD_MEMORY_MB=4096
LUMA_BUILD_DISK_MB=8192
LUMA_BUILD_POOL=default
TZ=Asia/Shanghai

# Nomad placement and cold-start budgets are separate.
LUMA_BUILD_PLACEMENT_TIMEOUT=60
LUMA_BUILD_STARTUP_TIMEOUT=600
