# ============================================================================
# 1. luma-build Service Secrets (Managed natively via Luma Scoped Secrets!)
#    Build & deploy with: luma build local builder --platform linux/amd64 --env builder/.env
#    Or update a single secret: luma secret set KEY VALUE --scope luma-build
# ============================================================================

# Luma Control URL (enables automatic 'luma login' SSO + deployment handoff)
LUMA_CONTROL_URL=https://luma.itool.tech
LUMA_DEPLOY_TOKEN=replace-with-luma-control-deploy-token

# --- Aliyun ACR Push Credentials (scoped ONLY to luma-build container!) ---
# Meanwhile, configure a READ-ONLY pull sub-account on Luma Control for worker nodes:
#   luma registry login crpi-xxxxxxxx.cn-beijing.personal.cr.aliyuncs.com --username <ro-user>
LUMA_BUILD_REGISTRY_HOST=crpi-xxxxxxxx.cn-beijing.personal.cr.aliyuncs.com
LUMA_BUILD_PUSH_HOST=crpi-xxxxxxxx.cn-beijing.personal.cr.aliyuncs.com
LUMA_BUILD_REGISTRY_NAMESPACE=luma
LUMA_BUILD_REGISTRY_USERNAME=replace-with-acr-push-username
LUMA_BUILD_REGISTRY_PASSWORD=replace-with-acr-push-password

# --- Git Pull Credentials (scoped ONLY to luma-build, leased per-build in memory) ---
GITHUB_TOKEN=replace-with-github-pat
GITEA_HOST=gcode.gaojiua.com
GITEA_USERNAME=Nickname4th
GITEA_TOKEN=replace-with-gitea-token

# Seconds to hold a new build for the warm runner that last built this repo+arch
LUMA_BUILD_AFFINITY_SECONDS=20

# ============================================================================
# 2. Stateless Runner Configuration (ONLY these 2 required on any runner box!)
# ============================================================================
# LUMA_BUILD_URL=https://build.itool.tech
# LUMA_RUNNER_TOKEN=lbr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LUMA_RUNNER_PROXY=http://127.0.0.1:7890
# LUMA_RUNNER_CACHE_MODE=read-write
# LUMA_RUNNER_CACHE_KEEP_GB=20
