{
  "uid": "luma-traces",
  "title": "Traces",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "tags": [
    "luma-observe",
    "traces"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoria"
        },
        "query": "label_values(luma_observe_router_app, app)",
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "App"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "traces",
      "title": "Recent traces",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"traefik\" || resource.luma.stack =~ \"$app\" }",
          "limit": 20
        }
      ]
    }
  ]
}
