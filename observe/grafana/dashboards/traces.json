{
  "uid": "luma-traces",
  "title": "Traces",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "tags": [
    "luma-observe",
    "traces"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoria"
        },
        "query": "label_values(luma_observe_router_app, app)",
        "includeAll": true,
        "multi": false,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "App"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Ingress traces (Traefik)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "traces",
          "query": "{ resource.service.name = \"traefik\" }",
          "limit": 20
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "App traces",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "traces",
          "query": "{ resource.luma.stack =~ \"$app\" }",
          "limit": 20
        }
      ]
    }
  ]
}
