{
  "uid": "luma-nomad-jobs",
  "title": "Nomad jobs",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "tags": [
    "luma-observe",
    "nomad"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoria"
        },
        "query": "label_values(luma_observe_job_running, app)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "label": "App"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Failed allocations now",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (luma_observe_job_failed{app=~\"$app\"})",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Running allocations",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app) (luma_observe_job_running{app=~\"$app\"})",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Live task restarts",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoria"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (app, task) (luma_observe_alloc_restarts{app=~\"$app\"})",
          "legendFormat": "{{app}} {{task}}"
        }
      ]
    }
  ]
}
