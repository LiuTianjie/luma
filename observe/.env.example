# Optional, independent bearer credentials. Empty values leave the role disabled.
# Generate each credential independently and store it in the luma-observe scope.
LUMA_OBSERVE_READ_TOKEN=
LUMA_OBSERVE_INGEST_TOKEN=
# JSON list of per-application readers, e.g.
# [{"name":"orders","token":"<32-512 chars>","namespace":"orders","apps":["orders-workers"]}]
LUMA_OBSERVE_SCOPED_READERS=
